# ============================================================
#  uploads/.htaccess   —   المسار:  /uploads/.htaccess
#  منع تنفيذ أي سكربت داخل مجلد الصور
# ============================================================
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pl|py|cgi|asp|aspx|sh|shtml)$">
    Require all denied
</FilesMatch>

Options -Indexes